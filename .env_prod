NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-domain.com

# Thông tin sự kiện & liên hệ
EVENT_NAME="Thủy Mộng"
EVENT_DATE=2026-10-17
EVENT_CHECKIN_TEXT="17:30 - 19:35 — Thứ Bảy, 17/10/2026"
EVENT_VENUE="Nhà Hát Múa Rối Việt Nam, 361 Trường Chinh, Thanh Xuân, Hà Nội"
CONTACT_PHONE="0901234567"
CONTACT_EMAIL="hotro@your-domain.com"

# VietQR & Thanh toán
BANK_CODE=MB
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME="CONG TY ABC"

# SePay Webhook (API Key khớp với SePay Webhook Settings)
SEPAY_WEBHOOK_API_KEY=your_very_long_sepay_api_key

# Quản trị & Mã hoá chữ ký (Bắt buộc chuỗi ngẫu nhiên mạnh)
ADMIN_USER=admin
ADMIN_PASSWORD=strong_admin_password_here
CAPTCHA_SECRET=random_hex_string_64_chars_captcha
QR_SECRET=random_hex_string_64_chars_qr

# Supabase (Lưu trữ đơn lâu dài trên môi trường Serverless)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gửi Email thông báo kèm QR (Chọn Gmail SMTP hoặc Resend)
# 1. Gmail SMTP (yêu cầu tạo Mật khẩu ứng dụng 16 ký tự của Google)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# 2. Hoặc Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Thủy Mộng <ticket@your-domain.com>"

# Google Sheet đồng bộ (Tuỳ chọn)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec

# Cờ vận hành (Production bắt buộc tắt hoặc bỏ trống)
SKIP_CAPTCHA=false
ALLOW_TEST_ORDERS=false
EMAIL_DRY_RUN=false